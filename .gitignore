build/

# Compiled module interfaces.  CMake keeps the ones it builds under build/, but
# a g++ invoked by hand drops a gcm.cache wherever it was run, and a stale one is
# how you get "failed to read compiled module" from a tree that is perfectly
# fine.
*.gcm
gcm.cache/

# Python leaves these next to any file it imports, which now includes the MCP
# server and the test that imports it.
__pycache__/
*.pyc

# minecrafts/ is a working Minecraft 1.8.9 install in three mappings: Mojang's
# jar, libraries, natives and assets, two remapped jars and three decompiled
# source trees.  Hundreds of megabytes, none of it ours, all of it rebuildable
# with `python minecrafts/mc.py all`.  The tooling that rebuilds it is tracked;
# everything it produces is not.
minecrafts/*
!minecrafts/.gitignore
!minecrafts/README.md
!minecrafts/mc.py
!minecrafts/mcbuild/

# One-shot migration scripts.  They did their job once -- the modules migration
# -- and what they produced is the code, which is what belongs here.  Keeping
# them tracked invites someone to re-run a transformation against a tree that
# has moved on.
tools/
